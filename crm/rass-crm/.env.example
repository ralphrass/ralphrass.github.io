# Copie para .env apenas se for rodar fora do Railway. No Railway, configure em Variables.

# Banco Postgres. Sem esta variável, o CRM usa um Postgres embutido (PGlite) em data/pg, só para desenvolvimento.
DATABASE_URL=

# Bucket S3 para os arquivos (Railway Bucket, Cloudflare R2, AWS S3). Sem isso, os arquivos ficam em data/arquivos.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1   # só se o bucket pedir URLs no estilo path

# 1 = qualquer pessoa pode criar uma corretora nova. Sem isso, só a primeira conta pode ser criada.
CADASTRO_ABERTO=

# Tamanho máximo de cada arquivo anexado, em MB
MAX_FILE_MB=25
